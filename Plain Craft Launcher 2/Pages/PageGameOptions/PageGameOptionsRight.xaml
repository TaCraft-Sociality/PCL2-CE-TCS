<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageGameOptionsRight"
    PanScroll="{Binding ElementName=PanBack, Mode=OneWay}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <TextBlock FontSize="24" FontWeight="Bold" Text="{DynamicResource GameOptions.Title}" />
            <TextBlock Margin="0,7,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="{DynamicResource GameOptions.Subtitle}" />

            <local:MyCard x:Name="CardOptions" Margin="0,15,0,15" Title="{DynamicResource GameOptions.Card.Options}">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BorCustomCount" Grid.Column="0" CornerRadius="9" Padding="10,3"
                                Background="{DynamicResource ColorBrushSemiTransparent}" VerticalAlignment="Center">
                            <TextBlock x:Name="LabCustomCount" FontSize="11.5" Text="0"
                                       Foreground="{DynamicResource ColorBrush3}" />
                        </Border>
                        <TextBlock x:Name="LabSaved" Grid.Column="1" Margin="12,0,12,0" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Margin="0,0,10,0" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                       Text="{DynamicResource GameOptions.Preview.Label}" />
                            <local:MyComboBox x:Name="ComboPreview" Width="176" Height="28"
                                              SelectionChanged="ComboPreview_SelectionChanged" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PanOptionRows" Orientation="Vertical" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource GameOptions.Card.World}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" LineHeight="19"
                               Text="{DynamicResource GameOptions.World.Hint}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource GameOptions.Card.Groups}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="{DynamicResource GameOptions.Groups.Hint}" />
                    <Grid x:Name="PanGroups">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PanGroupsLeft" Grid.Column="0" Orientation="Vertical" />
                        <StackPanel x:Name="PanGroupsRight" Grid.Column="2" Orientation="Vertical" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource GameOptions.Card.Rules}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock x:Name="LabRules" FontSize="12" Opacity="0.8" TextWrapping="Wrap" LineHeight="19"
                               Text="{DynamicResource GameOptions.Rules.Body}" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
