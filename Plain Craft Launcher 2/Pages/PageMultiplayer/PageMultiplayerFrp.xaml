<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PCL.PageMultiplayerFrp"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,12,25,20">
            <Grid Margin="0,4,0,10">
                <StackPanel>
                    <TextBlock Text="FRP 内网穿透" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,4,0,0"
                               Text="注册樱花穿透（natfrp.com）并创建隧道，用官方 frpc 把本地世界映射到公网。填写访问密钥后选择或创建隧道；可用性取决于节点、账号权限和网络。" />
                </StackPanel>
                <local:MyButton x:Name="BtnBack" HorizontalAlignment="Right" VerticalAlignment="Top" Height="28"
                                MinWidth="92" Text="← 更换方式" Click="BtnBack_Click" />
            </Grid>

            <Grid Margin="0,2,0,6">
                <TextBlock Text="我的隧道" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LabOnline" Text="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text=" 已连接 " Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabRecover" Text="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text=" 下次恢复" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                    <local:MyButton x:Name="BtnRefresh" Height="28" MinWidth="88" Margin="14,0,0,0" Text="刷新状态" Click="BtnRefresh_Click" />
                    <local:MyButton x:Name="BtnNew" Height="28" MinWidth="88" Margin="8,0,0,0" Text="新建隧道" ColorType="Highlight" Click="BtnNew_Click" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="LabTunnelTip" Opacity="0.55" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="▾ 自动恢复与连接说明：隧道开关由樱花启动器管理；这里读取账号里的隧道与公网地址，好友在游戏的「直接连接」里填这个地址。" />

            <Border CornerRadius="10" Background="{DynamicResource ColorBrushTransparentBackground}" BorderBrush="#22000000" BorderThickness="1" Padding="18,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="樱花穿透账号" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11.5" Margin="0,4,0,10"
                               Text="填写访问密钥，读取账号中的隧道与节点。已连接的隧道不会被其他隧道的操作打断。" />
                    <TextBlock Text="访问密钥" FontSize="12" Opacity="0.75" Margin="0,0,0,5" />
                    <Grid>
                        <PasswordBox x:Name="TextToken" Height="32" Margin="0,0,150,0" Padding="8,0" VerticalContentAlignment="Center" />
                        <local:MyButton x:Name="BtnRead" HorizontalAlignment="Right" Height="32" MinWidth="140"
                                        Text="读取我的隧道与节点" ColorType="Highlight" Click="BtnRead_Click" />
                    </Grid>
                    <TextBlock x:Name="LabTokenState" Opacity="0.55" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" Text="尚未保存访问密钥。" />
                    <Border Height="1" Background="#18000000" Margin="0,12,0,10" />
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnSite" Height="28" MinWidth="104" Text="樱花穿透官网 ↗" Click="BtnSite_Click" />
                            <local:MyButton x:Name="BtnGuide" Height="28" MinWidth="92" Margin="8,0,0,0" Text="使用指南 ↗" Click="BtnGuide_Click" />
                            <local:MyButton x:Name="BtnCopySite" Height="28" MinWidth="104" Margin="8,0,0,0" Text="复制官网地址" Click="BtnCopySite_Click" />
                            <local:MyButton x:Name="BtnClearToken" Height="28" MinWidth="110" Margin="8,0,0,0" Text="清除已保存密钥" Click="BtnClearToken_Click" />
                        </StackPanel>
                        <TextBlock Text="访问密钥仅保存在本机" Opacity="0.5" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Background="{DynamicResource ColorBrushTransparentBackground}" BorderBrush="#22000000" BorderThickness="1" Padding="18,14" Margin="0,0,0,10">
                <StackPanel x:Name="PanTunnels">
                    <TextBlock x:Name="LabEmptyTunnel" Text="还没有读取隧道" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock x:Name="LabEmptyTunnelTip" Text="读取账号后，每条隧道会在这里拥有独立的控制卡片。"
                               Opacity="0.55" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Background="{DynamicResource ColorBrushTransparentBackground}" BorderBrush="#22000000" BorderThickness="1" Padding="18,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="节点参考" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11.5" Margin="0,4,0,8"
                               Text="查看各节点的状态与说明，在上方选择可用节点创建隧道。专业版节点需要对应账号权限。" />
                    <local:MyListItem x:Name="ItemNodes" IsScaleAnimationEnabled="False" Type="Clickable" Height="30"
                                      Title="展开节点列表（默认收起）" LogoScale="0.85" SvgIcon="lucide/chevron-right"
                                      Click="ItemNodes_Click" />
                    <Grid Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="只看免费节点" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                            <CheckBox x:Name="CheckFreeOnly" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" Click="CheckFreeOnly_Click" />
                        </StackPanel>
                        <local:MyButton x:Name="BtnNodes" HorizontalAlignment="Right" Height="28" MinWidth="88" Text="查询节点" Click="BtnNodes_Click" />
                    </Grid>
                    <TextBlock x:Name="LabNodeTip" Opacity="0.55" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="填写访问密钥后点击「查询节点」查看节点列表。" />
                    <StackPanel x:Name="PanNodes" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border x:Name="BorderNew" Visibility="Collapsed" CornerRadius="10" Background="{DynamicResource ColorBrushTransparentBackground}" BorderBrush="#22000000" BorderThickness="1" Padding="18,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="创建新隧道" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11.5" Margin="0,4,0,12" Text="选择服务节点，再填入游戏局域网端口。创建成功后显示独立卡片，不会自动运行。" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="隧道名称" FontSize="12" Opacity="0.75" Margin="0,0,0,5" />
                            <TextBox x:Name="TextNewName" Height="30" Text="Minecraft" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="服务节点" FontSize="12" Opacity="0.75" Margin="0,0,0,5" />
                            <ComboBox x:Name="ComboNode" Height="30" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="本地端口" FontSize="12" Opacity="0.75" Margin="0,0,0,5" />
                            <TextBox x:Name="TextNewPort" Height="30" ToolTip="游戏对局域网开放后显示的端口" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="远程端口（可选）" FontSize="12" Opacity="0.75" Margin="0,0,0,5" />
                            <TextBox x:Name="TextNewRemote" Height="30" ToolTip="留空由樱花穿透分配" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="CheckNewFreeOnly" Content="仅显示免费节点" IsChecked="True" Margin="0,12,0,0" Click="CheckNewFreeOnly_Click" />
                    <local:MyButton x:Name="BtnCreateTunnel" Height="34" Margin="0,14,0,0" HorizontalAlignment="Stretch" Text="创建 TCP 隧道" ColorType="Highlight" Click="BtnCreateTunnel_Click" />
                    <TextBlock x:Name="LabNewTip" Opacity="0.55" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Text="" />
                </StackPanel>
            </Border>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
