<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PCL.PageMultiplayerRooms"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10,25,20">
            <TextBlock Text="选择联机方式" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,2" />
            <TextBlock Text="选择适合自己的方式，按指引与好友一起游玩。" Opacity="0.6" FontSize="12" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="CardFrp" CornerRadius="10" Padding="18" Background="{DynamicResource ColorBrushTransparentBackground}"
                        BorderBrush="#22000000" BorderThickness="1" MouseLeftButtonUp="Card_Click" Tag="frp">
                    <StackPanel>
                        <Border x:Name="TileFrp" Width="34" Height="34" CornerRadius="8" Background="#DFE3E8" HorizontalAlignment="Left">
                            <TextBlock Text="&#x1F310;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="FRP 内网穿透" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <Border x:Name="PillFrp" CornerRadius="9" Padding="8,2" Background="#EDF1F7" HorizontalAlignment="Left">
                            <TextBlock Text="公网隧道" FontSize="11" Opacity="0.75" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,10,0,0"
                                   Text="注册樱花穿透（natfrp.com）并创建隧道，用官方 frpc 把本地世界映射到公网。填写访问密钥后选择或创建隧道；可用性取决于节点、账号权限和网络。" />
                        <TextBlock Text="适合愿意配置隧道的玩家" FontSize="11" Margin="0,12,0,0" Foreground="#2f6fe4" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" x:Name="CardVox" CornerRadius="10" Padding="18" Background="{DynamicResource ColorBrushTransparentBackground}"
                        BorderBrush="#22000000" BorderThickness="1" MouseLeftButtonUp="Card_Click" Tag="vox">
                    <StackPanel>
                        <Border x:Name="TileVox" Width="34" Height="34" CornerRadius="8" Background="#DFE3E8" HorizontalAlignment="Left">
                            <TextBlock Text="&#x1F5A5;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="VoxLink 联机" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <Border x:Name="PillVox" CornerRadius="9" Padding="8,2" Background="#EDF1F7" HorizontalAlignment="Left">
                            <TextBlock Text="6 位房间码 · 免公网 IP" FontSize="11" Opacity="0.75" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,10,0,0"
                                   Text="创建房间，把 6 位房间码发给好友即可开始连接。连接成功后，按页面指引在游戏内输入地址。" />
                        <TextBlock Text="适合所有普通玩家的连接方式" FontSize="11" Margin="0,12,0,0" Foreground="#2f6fe4" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" x:Name="CardTerra" CornerRadius="10" Padding="18" Background="{DynamicResource ColorBrushTransparentBackground}"
                        BorderBrush="#2f6fe4" BorderThickness="1.4" MouseLeftButtonUp="Card_Click" Tag="terra">
                    <StackPanel>
                        <Border x:Name="TileTerra" Width="34" Height="34" CornerRadius="8" Background="#DFE3E8" HorizontalAlignment="Left">
                            <TextBlock Text="&#x1F4E6;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="陶瓦联机" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <Border x:Name="PillTerra" CornerRadius="9" Padding="8,2" Background="#EDF1F7" HorizontalAlignment="Left">
                            <TextBlock Text="独立开源 · 开箱即用" FontSize="11" Opacity="0.75" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,10,0,0"
                                   Text="独立开源联机项目（GitHub burningtnt/Terracotta，基于 EasyTier，AGPL-3.0）：自动下载官方工具并校验，创建 / 加入房间开箱即用。" />
                        <TextBlock Text="适合使用官方工具和房间码联机的玩家" FontSize="11" Margin="0,12,0,0" Foreground="#2f6fe4" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
