<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PCL.PageMultiplayerServers"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard x:Name="CardServers" Margin="0,15" Title="服务器">
                <StackPanel Margin="25,38,25,15">
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="LabCount" VerticalAlignment="Center" Opacity="0.65" FontSize="12" />
                        <local:MyButton x:Name="BtnAdd" HorizontalAlignment="Right" Height="28" MinWidth="96"
                                        Text="添加服务器" ColorType="Highlight" Click="BtnAdd_Click" />
                    </Grid>
                    <StackPanel x:Name="PanList" />
                    <TextBlock x:Name="LabEmpty" Margin="0,12,0,4" Opacity="0.5" TextWrapping="Wrap" FontSize="12"
                               Text="还没有服务器。点右上角「添加服务器」，填名称和地址（例如 play.example.com 或 1.2.3.4:25566）。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
