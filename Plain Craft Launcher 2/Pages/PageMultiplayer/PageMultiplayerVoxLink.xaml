<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PCL.PageMultiplayerVoxLink"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,12,25,20">
            <Grid Margin="0,4,0,10">
                <StackPanel>
                    <TextBlock Text="VoxLink 联机" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,4,0,0"
                               Text="安装 VoxLink 模组后，在游戏里创建房间，把 6 位房间码发给好友即可开始连接。直连尝试 20 秒后，可由玩家主动选择 TURN 中继；连接成功后按游戏内指引输入地址。" />
                </StackPanel>
                <local:MyButton x:Name="BtnBack" HorizontalAlignment="Right" VerticalAlignment="Top" Height="28"
                                MinWidth="92" Text="← 更换方式" Click="BtnBack_Click" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <TextBlock Text="先选择游戏实例，再安装模组并启动游戏。" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <local:MyButton x:Name="BtnLinks" Height="28" MinWidth="92" Text="相关链接 ↗" Click="BtnLinks_Click" />
                    <local:MyButton x:Name="BtnHome" Height="28" MinWidth="80" Margin="8,0,0,0" Text="官网" Click="BtnHome_Click" />
                </StackPanel>
            </Grid>

            <Border CornerRadius="10" Background="{DynamicResource ColorBrushTransparentBackground}" BorderBrush="#22000000" BorderThickness="1" Padding="18,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="游戏与房间" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Text="游戏实例" FontSize="12" Opacity="0.75" Margin="0,0,0,5" />
                    <Border x:Name="BorderInstance" Height="32" CornerRadius="6" BorderBrush="#33000000" BorderThickness="1" Background="{DynamicResource ColorBrushTransparentBackground}"
                            Cursor="Hand" MouseLeftButtonUp="BorderInstance_Click">
                        <Grid Margin="10,0">
                            <TextBlock x:Name="LabInstance" VerticalAlignment="Center" Text="选择游戏实例" FontSize="12.5" />
                            <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.5" />
                        </Grid>
                    </Border>
                    <Border x:Name="BorderPicker" Visibility="Collapsed" Margin="0,4,0,0" Background="{DynamicResource ColorBrushTransparentBackground}" CornerRadius="8"
                            BorderBrush="#33000000" BorderThickness="1" Padding="6" MaxHeight="320">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanInstancePicker" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="安装模组和启动游戏都使用此实例。" Opacity="0.55" FontSize="11.5" Margin="0,5,0,0" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock x:Name="LabModState" VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
                        <local:MyButton x:Name="BtnInstall" HorizontalAlignment="Right" Height="30" MinWidth="128"
                                        Text="安装 VoxLink 模组" ColorType="Highlight" Click="BtnInstall_Click" />
                    </Grid>

                    <Border Height="1" Background="#18000000" Margin="0,14,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="创建房间" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11.5" Margin="0,6,0,8"
                                       Text="启动游戏后进入世界，选择「对局域网开放」，模组会生成 6 位房间码。" />
                            <local:MyButton x:Name="BtnCreate" Height="32" MinWidth="150" HorizontalAlignment="Left"
                                            Text="启动游戏并建房 →" ColorType="Highlight" Click="BtnCreate_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="加入房间" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="好友的房间码" FontSize="12" Opacity="0.75" Margin="0,6,0,5" />
                            <TextBox x:Name="TextCode" Height="30" />
                            <local:MyButton x:Name="BtnJoin" Height="32" MinWidth="150" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Text="启动游戏并加入 →" ColorType="Highlight" Click="BtnJoin_Click" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="11.5" Margin="0,8,0,0"
                                       Text="启动后在游戏内的联动界面填这个房间码即可加入。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Background="{DynamicResource ColorBrushTransparentBackground}" BorderBrush="#22000000" BorderThickness="1" Padding="18,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="公共大厅" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <TextBox x:Name="TextSearch" Height="30" Margin="0,0,110,0" ToolTip="搜索房间名..." TextChanged="TextSearch_TextChanged" />
                        <local:MyButton x:Name="BtnRefreshLobby" HorizontalAlignment="Right" Height="30" MinWidth="96"
                                        Text="刷新大厅" Click="BtnRefreshLobby_Click" />
                    </Grid>
                    <TextBlock x:Name="LabLobbyTip" Margin="0,10,0,0" Opacity="0.55" FontSize="11.5" TextWrapping="Wrap"
                               Text="正在从 VoxLink 中继拉取公共大厅…" />
                    <StackPanel x:Name="PanLobby" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="连接记录 · 0 条" FontSize="13" FontWeight="SemiBold" Margin="2,8,0,4" />
            <TextBox x:Name="TextLog" Height="110" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
