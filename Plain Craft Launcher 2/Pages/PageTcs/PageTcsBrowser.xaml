<local:MyPageRight x:Class="PCL.PageTcsBrowser"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid x:Name="PanRoot" Margin="25,16,25,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 浏览器工具栏（联机页会隐藏它，让陶瓦界面满屏显示） -->
        <Grid x:Name="PanToolbar" Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <local:MyIconButton x:Name="BtnBack" Width="30" Height="30" Margin="0,0,6,0"
                                    ToolTip="后退" LogoScale="0.85" SvgIcon="lucide/arrow-left"
                                    Click="BtnBack_Click" />
                <local:MyIconButton x:Name="BtnForward" Width="30" Height="30" Margin="0,0,6,0"
                                    ToolTip="前进" LogoScale="0.85" SvgIcon="lucide/arrow-right"
                                    Click="BtnForward_Click" />
                <local:MyIconButton x:Name="BtnHome" Width="30" Height="30" Margin="0,0,6,0"
                                    ToolTip="回到首页" LogoScale="0.9" SvgIcon="lucide/globe"
                                    Click="BtnHome_Click" />
            </StackPanel>
            <TextBlock x:Name="LabUrl" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                       FontSize="12.5" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <local:MyIconButton x:Name="BtnRefresh" Width="30" Height="30" Margin="0,0,6,0"
                                    ToolTip="刷新页面" LogoScale="0.9" SvgIcon="lucide/refresh-cw"
                                    Click="BtnRefresh_Click" />
                <local:MyIconButton x:Name="BtnExternal" Width="30" Height="30"
                                    ToolTip="在系统浏览器中打开" LogoScale="0.85"
                                    SvgIcon="lucide/external-link" Click="BtnExternal_Click" />
            </StackPanel>
        </Grid>

        <!-- 浏览器本体 -->
        <Grid x:Name="PanBrowserHost" Grid.Row="1">
            <Border Background="{DynamicResource ColorBrushWhite}" CornerRadius="8" ClipToBounds="True">
                <wv:WebView2 x:Name="Browser" />
            </Border>
            <Grid x:Name="PanLoading" Background="{DynamicResource ColorBrushWhite}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LabLoading" Text="正在加载页面…" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="LabLoadingUrl" FontSize="12" Opacity="0.45" Margin="0,6,0,0"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="420" />
                </StackPanel>
            </Grid>
            <local:MyCard x:Name="PanError" Title="页面加载失败" Visibility="Collapsed"
                          VerticalAlignment="Top">
                <StackPanel Margin="25,38,23,20">
                    <TextBlock x:Name="LabError" TextWrapping="Wrap" FontSize="13.5" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnRetry" MinWidth="100" Text="重试" Margin="0,0,10,0"
                                        ColorType="Highlight" Click="BtnRetry_Click" />
                        <local:MyButton x:Name="BtnErrorExternal" MinWidth="140" Text="在系统浏览器中打开"
                                        Click="BtnErrorExternal_Click" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </Grid>
    </Grid>
</local:MyPageRight>
